# Database Configuration
DATABASE_URL=postgresql://translator:translator_password@localhost:5432/audio_translator

# Whisper Model Configuration
# Options: tiny (39MB), base (74MB), small (244MB), medium (769MB)
WHISPER_MODEL=base

# Translation Backend
# Options: libretranslate, nllb
TRANSLATION_BACKEND=libretranslate

# LibreTranslate API (if using libretranslate backend)
LIBRETRANSLATE_URL=https://libretranslate.de

# CORS Origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3000

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Optional: Redis for caching (if using Redis)
# REDIS_URL=redis://localhost:6379/0

# Optional: Enable debug mode
DEBUG=True
